  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@types/three": "^0.176.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
